---
import Layout from '../layouts/Layout.astro';


---

<Layout title="GitSy - Sync a Notes Folder with Git">
  
  
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-text">
            <h1>Sync a Notes Folder with Git</h1>
            <p class="hero-description">
              GitSy is an Android app for synchronizing a selected local folder with a Git repository
              over HTTPS or SSH. Use it with GitHub, GitLab, or another compatible Git server while keeping
              your files in a repository you control.
              <a href="/docs/closedtesting/">Join Closed Testing</a>
            </p>
            <div class="hero-buttons">
              <a href="/download" class="btn btn-primary">Download GitSy</a>
              <a href="/about" class="btn btn-secondary">Learn More</a>
            </div>
          </div>
          <div class="hero-image">
            <img src="/images/screenshot_light_list_crop.png" alt="Note taking on mobile device" />
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features">
      <div class="container">
        <div class="section-header">
          <h2>Why Choose GitSy?</h2>
          <p>Keep your local files and a Git repository in sync from Android</p>
        </div>
        
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">🔄</div>
            <h3>Git-based Sync</h3>
            <p>Use an HTTPS or SSH Git repository to sync the folder you select in GitSy. Your files stay in your own repository.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon">📱</div>
            <h3>Android Folder Sync</h3>
            <p>Select a local folder through Android's storage picker and connect it to a remote repository.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon">🔒</div>
            <h3>Credentials Protected</h3>
            <p>Git credentials are stored on your device, while your file contents remain in your chosen folder and Git repository.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon">⚡</div>
            <h3>Manual Sync</h3>
            <p>Start synchronization for one repository or all configured repositories directly from the app.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon">📝</div>
            <h3>Plain Files</h3>
            <p>GitSy works with files in the selected folder, so you can use your preferred note editor alongside it.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon">🔍</div>
            <h3>Periodic Check</h3>
            <p>When the app is opened, GitSy can queue ready projects for synchronization if they have not synced recently.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How it Works Section -->
    <section class="how-it-works">
      <div class="container">
        <div class="section-header">
          <h2>How to join closed testing</h2>
          <p>Get started with testing GitSy in just a few simple steps</p>
        </div>
        
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>Open the GitSy testing page</h3>
              <p>Open the <a href="https://play.google.com/apps/testing/me.maxistar.gitsy">GitSy Google Play testing page</a>.</p>
            </div>
          </div>
          
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>Join the alpha closed test</h3>
              <p>Confirm your participation in the GitSy closed test on the enrollment page.</p>
            </div>
          </div>
          
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>Download the application</h3>
              <p>Install the GitSy app from the <a href="https://play.google.com/store/apps/details?id=me.maxistar.gitsy">Play Store</a></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta">
      <div class="container">
        <div class="cta-content">
          <h2>Ready to Get Started?</h2>
          <p>Install GitSy and test Git-based folder synchronization on Android.</p>
          <a href="/download" class="btn btn-primary btn-large">Download GitSy</a>
        </div>
      </div>
    </section>
  </main>

  
</Layout>

<style>
  .hero {
    padding: 4rem 0;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-text h1 {
    font-size: 3rem;
    margin-bottom: 1.5rem;
    color: #111827;
  }

  .hero-description {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    color: #6b7280;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  }

  .features {
    padding: 5rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    margin-bottom: 1rem;
  }

  .section-header p {
    font-size: 1.125rem;
    color: #6b7280;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    padding: 2rem;
    background: white;
    border-radius: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.1);
  }

  .feature-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    margin-bottom: 0.75rem;
  }

  .how-it-works {
    padding: 5rem 0;
    background: #f9fafb;
  }

  .steps {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .step {
    flex: 1;
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .step-number {
    width: 3rem;
    height: 3rem;
    background: #2563eb;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .step-content h3 {
    margin-bottom: 0.5rem;
  }

  .cta {
    padding: 5rem 0;
    background: #2563eb;
    color: white;
  }

  .cta-content {
    text-align: center;
  }

  .cta h2 {
    color: white;
    margin-bottom: 1rem;
  }

  .cta p {
    font-size: 1.125rem;
    margin-bottom: 2rem;
    color: #bfdbfe;
  }

  .btn-large {
    padding: 1rem 2rem;
    font-size: 1.125rem;
  }

  @media (max-width: 1024px) {
    .steps {
      flex-direction: column;
    }
  }

  @media (max-width: 768px) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-text h1 {
      font-size: 2.5rem;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .step {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
