---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="GitSy - Synchronisiere einen Ordner mit Git">
  
  
  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-text">
            <h1>Synchronisiere einen Ordner mit Git</h1>
            <p class="hero-description">
              GitSy ist eine Android-App zur Synchronisation eines ausgewählten lokalen Ordners mit
              einem Git-Repository über HTTPS oder SSH. Nutze GitHub, GitLab oder einen kompatiblen Git-Server,
              während deine Dateien in einem Repository unter deiner Kontrolle bleiben.
              <a href="/de/docs/closedtesting/">An geschlossenen Tests teilnehmen</a>
            </p>
            <div class="hero-buttons">
              <a href="/de/download" class="btn btn-primary">GitSy herunterladen</a>
              <a href="/de/about" class="btn btn-secondary">Mehr erfahren</a>
            </div>
          </div>
          <div class="hero-image">
            <img src="/images/screenshot_light_list_crop.png" alt="Notizen erstellen auf mobilem Gerät" />
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features">
      <div class="container">
        <div class="section-header">
          <h2>Warum GitSy wählen?</h2>
          <p>Synchronisiere lokale Dateien und ein Git-Repository von Android aus</p>
        </div>
        
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">🔄</div>
            <h3>Git-basierte Synchronisation</h3>
            <p>Verwende ein HTTPS- oder SSH-Git-Repository, um den in GitSy ausgewählten Ordner zu synchronisieren. Deine Dateien bleiben in deinem Repository.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon">📱</div>
            <h3>Android-Ordnersync</h3>
            <p>Wähle einen lokalen Ordner über Androids Ordnerauswahl und verbinde ihn mit einem Remote-Repository.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon">🔒</div>
            <h3>Geschützte Zugangsdaten</h3>
            <p>Git-Zugangsdaten werden auf deinem Gerät gespeichert; Dateiinhalte bleiben im gewählten Ordner und Git-Repository.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon">⚡</div>
            <h3>Manuelle Synchronisation</h3>
            <p>Starte die Synchronisation für ein Repository oder alle konfigurierten Projekte direkt aus der App.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon">📝</div>
            <h3>Normale Dateien</h3>
            <p>GitSy arbeitet mit Dateien im ausgewählten Ordner, sodass du deinen bevorzugten Notiz-Editor weiter nutzen kannst.</p>
          </div>
          
          <div class="feature-card">
            <div class="feature-icon">🔍</div>
            <h3>Periodische Prüfung</h3>
            <p>Beim Öffnen der App kann GitSy bereite Projekte zur Synchronisation einreihen, wenn sie länger nicht synchronisiert wurden.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How it Works Section -->
    <section class="how-it-works">
      <div class="container">
        <div class="section-header">
          <h2>So funktioniert es</h2>
          <p>Starte mit GitSy in nur wenigen einfachen Schritten</p>
        </div>
        
        <div class="steps">
          <div class="step">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>Repository erstellen</h3>
              <p>Richte ein neues Repository auf GitHub, GitLab oder deinem bevorzugten Git-Hosting-Service ein.</p>
            </div>
          </div>
          
          <div class="step">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>GitSy konfigurieren</h3>
              <p>Verbinde GitSy mit deinem Repository durch einfache Authentifizierung.</p>
            </div>
          </div>
          
          <div class="step">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>Ordner auswählen</h3>
              <p>Wähle einen leeren lokalen Ordner, verbinde ihn mit dem Repository und starte die Synchronisation in GitSy.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta">
      <div class="container">
        <div class="cta-content">
          <h2>Bereit loszulegen?</h2>
          <p>Installiere GitSy und teste Git-basierte Ordnersynchronisation auf Android.</p>
          <a href="/de/download" class="btn btn-primary btn-large">GitSy herunterladen</a>
        </div>
      </div>
    </section>
  </main>

  
</Layout>

<style>
  .hero {
    padding: 4rem 0;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-text h1 {
    font-size: 3rem;
    margin-bottom: 1.5rem;
    color: #111827;
  }

  .hero-description {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    color: #6b7280;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  }

  .features {
    padding: 5rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    margin-bottom: 1rem;
  }

  .section-header p {
    font-size: 1.125rem;
    color: #6b7280;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    padding: 2rem;
    background: white;
    border-radius: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.1);
  }

  .feature-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    margin-bottom: 0.75rem;
  }

  .how-it-works {
    padding: 5rem 0;
    background: #f9fafb;
  }

  .steps {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .step {
    flex: 1;
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .step-number {
    width: 3rem;
    height: 3rem;
    background: #2563eb;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .step-content h3 {
    margin-bottom: 0.5rem;
  }

  .cta {
    padding: 5rem 0;
    background: #2563eb;
    color: white;
  }

  .cta-content {
    text-align: center;
  }

  .cta h2 {
    color: white;
    margin-bottom: 1rem;
  }

  .cta p {
    font-size: 1.125rem;
    margin-bottom: 2rem;
    color: #bfdbfe;
  }

  .btn-large {
    padding: 1rem 2rem;
    font-size: 1.125rem;
  }

  @media (max-width: 1024px) {
    .steps {
      flex-direction: column;
    }
  }

  @media (max-width: 768px) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-text h1 {
      font-size: 2.5rem;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .step {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
